{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "logo-cloud-five",
	"title": "Logo Cloud Five",
	"type": "registry:block",
	"description": "A flexible wrapped logo cloud designed for broader brand collections.",
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport { extendedWordmarkLogos as logos } from \"../wordmark-logos\";\n</script>\n\n<div\n\tclass=\"relative flex flex-wrap items-center justify-center gap-x-10 gap-y-8 py-6 sm:gap-x-12 sm:gap-y-12\"\n>\n\t{#each logos as logo}\n\t\t<img\n\t\t\talt={logo.alt}\n\t\t\tclass=\"pointer-events-none h-5 w-fit select-none dark:brightness-0 dark:invert\"\n\t\t\theight={logo.height}\n\t\t\tloading=\"lazy\"\n\t\t\tsrc={logo.src}\n\t\t\twidth={logo.width}\n\t\t/>\n\t{/each}\n</div>\n",
			"type": "registry:component",
			"target": "efferd/logo-cloud/five/logo-cloud-five.svelte"
		}
	]
}