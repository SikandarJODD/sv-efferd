		{
			"content": "<script lang=\"ts\">\n\timport { CardContent } from \"#lib/components/ui/card/index.js\";\n\timport { FieldGroup, FieldSeparator } from \"#lib/components/ui/field/index.js\";\n\timport { Input } from \"#lib/components/ui/input/index.js\";\n\timport { Switch } from \"#lib/components/ui/switch/index.js\";\n\timport { ToggleGroup, ToggleGroupItem } from \"#lib/components/ui/toggle-group/index.js\";\n\timport SettingField from \"./setting-field.svelte\";\n\timport SettingsSection from \"./settings-section.svelte\";\n\n\tconst statuses = [\n\t\t{ value: \"online\", label: \"Online\", color: \"bg-emerald-500\" },\n\t\t{ value: \"away\", label: \"Away\", color: \"bg-amber-500\" },\n\t\t{ value: \"offline\", label: \"Offline\", color: \"bg-rose-500\" }\n\t] as const;\n\n\tlet status = $state(\"online\");\n\tlet autoAssign = $state(true);\n</script>\n\n<SettingsSection description=\"When and how much work gets routed to you.\" title=\"Availability\">\n\t<CardContent class=\"flex-1 px-0 py-(--card-spacing)\">\n\t\t<FieldGroup class=\"gap-5\">\n\t\t\t<SettingField\n\t\t\t\tdescription=\"Shown to teammates in the queue.\"\n\t\t\t\thtmlFor=\"status\"\n\t\t\t\tlabel=\"Status\"\n\t\t\t>\n\t\t\t\t<ToggleGroup\n\t\t\t\t\taria-label=\"Status\"\n\t\t\t\t\tbind:value={status}\n\t\t\t\t\tid=\"status\"\n\t\t\t\t\ttype=\"single\"\n\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t>\n\t\t\t\t\t{#each statuses as option (option.value)}\n\t\t\t\t\t\t<ToggleGroupItem value={option.value}>\n\t\t\t\t\t\t\t<span class=\"flex items-center gap-1.5\">\n\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\tclass={[\"size-2 rounded-full\", option.color]}\n\t\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t\t></span>\n\t\t\t\t\t\t\t\t{option.label}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</ToggleGroupItem>\n\t\t\t\t\t{/each}\n\t\t\t\t</ToggleGroup>\n\t\t\t</SettingField>\n\t\t\t<FieldSeparator />\n\t\t\t<SettingField\n\t\t\t\tdescription=\"Outside these hours you're set to away.\"\n\t\t\t\thtmlFor=\"hours-start\"\n\t\t\t\tlabel=\"Working hours\"\n\t\t\t>\n\t\t\t\t<div class=\"flex items-center gap-2\">\n\t\t\t\t\t<Input\n\t\t\t\t\t\taria-label=\"Start time\"\n\t\t\t\t\t\tclass=\"w-32\"\n\t\t\t\t\t\tid=\"hours-start\"\n\t\t\t\t\t\ttype=\"time\"\n\t\t\t\t\t\tvalue=\"09:00\"\n\t\t\t\t\t/>\n\t\t\t\t\t<span class=\"text-xs text-muted-foreground\">to</span>\n\t\t\t\t\t<Input aria-label=\"End time\" class=\"w-32\" type=\"time\" value=\"17:00\" />\n\t\t\t\t</div>\n\t\t\t</SettingField>\n\t\t\t<FieldSeparator />\n\t\t\t<SettingField\n\t\t\t\tdescription=\"Assign new threads to you automatically.\"\n\t\t\t\thtmlFor=\"auto-assign\"\n\t\t\t\tlabel=\"Auto-assign\"\n\t\t\t\torientation=\"horizontal\"\n\t\t\t>\n\t\t\t\t<Switch bind:checked={autoAssign} id=\"auto-assign\" />\n\t\t\t</SettingField>\n\t\t</FieldGroup>\n\t</CardContent>\n</SettingsSection>\n",
			"type": "registry:component",
			"target": "efferd/settings/settings-three/availability-settings.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { CardContent } from \"#lib/components/ui/card/index.js\";\n\timport { Checkbox } from \"#lib/components/ui/checkbox/index.js\";\n\timport { FieldGroup, FieldSeparator } from \"#lib/components/ui/field/index.js\";\n\timport SettingField from \"./setting-field.svelte\";\n\timport SettingsSection from \"./settings-section.svelte\";\n\n\tconst methods = [\"Email\", \"Push\", \"Desktop\"] as const;\n\ttype Method = (typeof methods)[number];\n\n\tconst events: { id: string; label: string; description: string; enabled: Method[] }[] = [\n\t\t{\n\t\t\tid: \"assigned\",\n\t\t\tlabel: \"Conversation assigned\",\n\t\t\tdescription: \"A thread is routed to you.\",\n\t\t\tenabled: [\"Email\", \"Push\", \"Desktop\"]\n\t\t},\n\t\t{\n\t\t\tid: \"reply\",\n\t\t\tlabel: \"Customer replied\",\n\t\t\tdescription: \"New message on your open threads.\",\n\t\t\tenabled: [\"Push\", \"Desktop\"]\n\t\t},\n\t\t{\n\t\t\tid: \"mention\",\n\t\t\tlabel: \"Mentioned\",\n\t\t\tdescription: \"A teammate @mentions you in a note.\",\n\t\t\tenabled: [\"Email\", \"Push\"]\n\t\t},\n\t\t{\n\t\t\tid: \"sla\",\n\t\t\tlabel: \"SLA at risk\",\n\t\t\tdescription: \"A reply is due in under 15 minutes.\",\n\t\t\tenabled: [\"Email\", \"Push\", \"Desktop\"]\n\t\t}\n\t];\n</script>\n\n<SettingsSection description=\"Pick how you hear about each event.\" title=\"Notifications\">\n\t<CardContent class=\"flex-1 px-0 py-(--card-spacing)\">\n\t\t<FieldGroup class=\"gap-5\">\n\t\t\t<div class=\"flex justify-end px-(--card-spacing)\">\n\t\t\t\t<div class=\"grid w-56 grid-cols-3 justify-items-center gap-2\">\n\t\t\t\t\t{#each methods as method (method)}\n\t\t\t\t\t\t<span class=\"text-xs text-muted-foreground\">{method}</span>\n\t\t\t\t\t{/each}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t{#each events as event, index (event.id)}\n\t\t\t\t{#if index > 0}<FieldSeparator />{/if}\n\t\t\t\t<SettingField\n\t\t\t\t\tdescription={event.description}\n\t\t\t\t\thtmlFor={`${event.id}-email`}\n\t\t\t\t\tlabel={event.label}\n\t\t\t\t>\n\t\t\t\t\t<div class=\"grid w-56 grid-cols-3 justify-items-center gap-2\">\n\t\t\t\t\t\t{#each methods as method (method)}\n\t\t\t\t\t\t\t<Checkbox\n\t\t\t\t\t\t\t\taria-label={`${event.label} via ${method}`}\n\t\t\t\t\t\t\t\tchecked={event.enabled.includes(method)}\n\t\t\t\t\t\t\t\tid={`${event.id}-${method.toLowerCase()}`}\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t{/each}\n\t\t\t\t\t</div>\n\t\t\t\t</SettingField>\n\t\t\t{/each}\n\t\t</FieldGroup>\n\t</CardContent>\n</SettingsSection>\n",
			"type": "registry:component",
			"target": "efferd/settings/settings-three/notification-settings.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport {\n\t\tAlertDialog,\n\t\tAlertDialogAction,\n\t\tAlertDialogCancel,\n\t\tAlertDialogContent,\n\t\tAlertDialogDescription,\n\t\tAlertDialogFooter,\n\t\tAlertDialogHeader,\n\t\tAlertDialogTitle,\n\t\tAlertDialogTrigger\n\t} from \"#lib/components/ui/alert-dialog/index.js\";\n\timport { Button } from \"#lib/components/ui/button/index.js\";\n\timport { CardContent } from \"#lib/components/ui/card/index.js\";\n\timport { FieldGroup, FieldSeparator } from \"#lib/components/ui/field/index.js\";\n\timport SettingField from \"./setting-field.svelte\";\n\timport SettingsSection from \"./settings-section.svelte\";\n</script>\n\n<SettingsSection\n\tclass=\"lg:col-span-4\"\n\tdescription=\"Irreversible and destructive actions.\"\n\ttitle=\"Danger zone\"\n>\n\t<CardContent class=\"flex-1 px-0 py-(--card-spacing)\">\n\t\t<FieldGroup class=\"gap-5\">\n\t\t\t<SettingField\n\t\t\t\tdescription=\"End every signed-in session except this one.\"\n\t\t\t\thtmlFor=\"sign-out-sessions\"\n\t\t\t\tlabel=\"Sessions\"\n\t\t\t\torientation=\"horizontal\"\n\t\t\t>\n\t\t\t\t<Button id=\"sign-out-sessions\" size=\"sm\" type=\"button\" variant=\"outline\"\n\t\t\t\t\t>Sign out all</Button\n\t\t\t\t>\n\t\t\t</SettingField>\n\t\t\t<FieldSeparator />\n\t\t\t<SettingField\n\t\t\t\tdescription=\"Remove your account and assigned threads.\"\n\t\t\t\thtmlFor=\"delete-account\"\n\t\t\t\tlabel=\"Delete account\"\n\t\t\t\torientation=\"horizontal\"\n\t\t\t>\n\t\t\t\t<AlertDialog>\n\t\t\t\t\t<AlertDialogTrigger>\n\t\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t\t<Button\n\t\t\t\t\t\t\t\t{...props}\n\t\t\t\t\t\t\t\tid=\"delete-account\"\n\t\t\t\t\t\t\t\tsize=\"sm\"\n\t\t\t\t\t\t\t\ttype=\"button\"\n\t\t\t\t\t\t\t\tvariant=\"destructive\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\tDelete\n\t\t\t\t\t\t\t</Button>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</AlertDialogTrigger>\n\t\t\t\t\t<AlertDialogContent size=\"sm\">\n\t\t\t\t\t\t<AlertDialogHeader>\n\t\t\t\t\t\t\t<AlertDialogTitle>Delete your account?</AlertDialogTitle>\n\t\t\t\t\t\t\t<AlertDialogDescription>\n\t\t\t\t\t\t\t\tThis permanently removes your profile, open conversations assigned\n\t\t\t\t\t\t\t\tto you, and notification preferences. This cannot be undone.\n\t\t\t\t\t\t\t</AlertDialogDescription>\n\t\t\t\t\t\t</AlertDialogHeader>\n\t\t\t\t\t\t<AlertDialogFooter>\n\t\t\t\t\t\t\t<AlertDialogCancel>Cancel</AlertDialogCancel>\n\t\t\t\t\t\t\t<AlertDialogAction variant=\"destructive\"\n\t\t\t\t\t\t\t\t>Delete account</AlertDialogAction\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t</AlertDialogFooter>\n\t\t\t\t\t</AlertDialogContent>\n\t\t\t\t</AlertDialog>\n\t\t\t</SettingField>\n\t\t</FieldGroup>\n\t</CardContent>\n</SettingsSection>\n",
			"type": "registry:component",
			"target": "efferd/settings/settings-three/danger-settings.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Card, CardDescription, CardHeader, CardTitle } from \"#lib/components/ui/card/index.js\";\n\timport { cn } from \"#lib/utils.js\";\n\timport type { ComponentProps, Snippet } from \"svelte\";\n\n\ttype Props = ComponentProps<typeof Card> & {\n\t\ttitle: string;\n\t\tdescription: string;\n\t\tchildren: Snippet;\n\t};\n\n\tlet { title, description, children, class: className, ...restProps }: Props = $props();\n</script>\n\n<Card class={cn(\"gap-0 pb-0 shadow-none dark:ring-0\", className)} {...restProps}>\n\t<CardHeader class=\"border-b\">\n\t\t<CardTitle>{title}</CardTitle>\n\t\t<CardDescription>{description}</CardDescription>\n\t</CardHeader>\n\t{@render children()}\n</Card>\n",
			"type": "registry:component",
			"target": "efferd/settings/settings-three/settings-section.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport {\n\t\tField,\n\t\tFieldContent,\n\t\tFieldDescription,\n\t\tFieldLabel\n\t} from \"#lib/components/ui/field/index.js\";\n\timport { cn } from \"#lib/utils.js\";\n\timport type { ComponentProps, Snippet } from \"svelte\";\n\n\ttype Props = ComponentProps<typeof Field> & {\n\t\tlabel: string;\n\t\tdescription: string;\n\t\thtmlFor: string;\n\t\tchildren: Snippet;\n\t};\n\n\tlet { label, description, htmlFor, children, class: className, ...restProps }: Props = $props();\n</script>\n\n<Field\n\tclass={cn(\n\t\t\"px-(--card-spacing) @md/field-group:has-[>[data-slot=field-content]]:items-center\",\n\t\tclassName\n\t)}\n\torientation=\"responsive\"\n\t{...restProps}\n>\n\t<FieldContent>\n\t\t<FieldLabel class=\"font-normal\" for={htmlFor}>{label}</FieldLabel>\n\t\t<FieldDescription class=\"text-xs\">{description}</FieldDescription>\n\t</FieldContent>\n\t<FieldContent class=\"items-end\">\n\t\t{@render children()}\n\t</FieldContent>\n</Field>\n",
			"type": "registry:component",
			"target": "efferd/settings/settings-three/setting-field.svelte"
		}
	]
