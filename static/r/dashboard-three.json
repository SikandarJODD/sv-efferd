			"content": "<script lang=\"ts\">\n\timport { cn } from \"#lib/utils.js\";\n\n\tlet {\n\t\tcolor = \"emerald\",\n\t\tpulse = true,\n\t\tclass: className\n\t}: {\n\t\tcolor?: \"emerald\" | \"rose\" | \"amber\" | \"sky\";\n\t\tpulse?: boolean;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst tone = $derived({\n\t\temerald: \"text-emerald-500\",\n\t\trose: \"text-rose-500\",\n\t\tamber: \"text-amber-500\",\n\t\tsky: \"text-sky-500\"\n\t}[color]);\n</script>\n\n<span class={cn(\"relative flex size-2 shrink-0 items-center justify-center rounded-full\", tone, className)}>\n\t<span aria-hidden=\"true\" class={cn(\"absolute size-full rounded-full bg-current\", pulse ? \"animate-ping\" : \"hidden\")}></span>\n\t<span aria-hidden=\"true\" class=\"size-1.5 rounded-full bg-current\"></span>\n</span>\n",
