			"content": "import { parseIsoCalendarDate } from \"./formatter.js\";\n\nconst values = [\n\t162, 162, 162, 162, 162, 162, 161, 161, 160, 160, 159, 158, 158, 157, 157, 157,\n\t157, 157, 157, 157, 157, 157, 157, 157, 156, 156, 155, 155, 154, 153, 152, 151,\n\t150, 149, 149, 150, 147, 151, 147, 145, 143, 141, 139, 137, 137, 137, 137, 137,\n\t137, 136, 134, 132, 129, 127, 125, 124, 124, 124, 124, 124, 124, 122, 120, 118,\n\t115, 113, 112, 111, 114, 110, 113, 111, 111, 107, 109, 105, 103, 101, 98, 100,\n\t97, 101, 99, 100, 94, 102, 99, 107, 104, 118, 127\n];\n\nconst firstDate = parseIsoCalendarDate(\"2026-02-18\");\n\nexport const conversationVolumeData = values.map((conversations, index) => {\n\tconst date = new Date(firstDate);\n\tdate.setDate(date.getDate() + index);\n\treturn { date, conversations };\n});\n",
