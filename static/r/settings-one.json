{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "settings-one",
	"title": "Settings One",
	"type": "registry:block",
	"description": "A settings form for profile details and email preferences. It includes an avatar picker and save action.",
