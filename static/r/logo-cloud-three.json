{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "logo-cloud-three",
	"title": "Logo Cloud Three",
	"type": "registry:block",
	"description": "A scrolling logo marquee with a soft edge mask and editorial rhythm.",
	"registryDependencies": [
		"./marquee.json"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n\timport { Marquee } from \"#lib/components/magic/marquee/index.js\";\n\timport { wordmarkLogos as logos } from \"../wordmark-logos\";\n</script>\n\n<div class=\"overflow-hidden mask-[linear-gradient(to_right,transparent,black,transparent)] py-4\">\n\t<Marquee>\n\t\t{#each logos as logo}\n\t\t\t<img\n\t\t\t\talt={logo.alt}\n\t\t\t\tclass=\"pointer-events-none h-4 select-none md:h-5 dark:brightness-0 dark:invert\"\n\t\t\t\theight={logo.height}\n\t\t\t\tloading=\"lazy\"\n\t\t\t\tsrc={logo.src}\n\t\t\t\twidth={logo.width}\n\t\t\t/>\n\t\t{/each}\n\t</Marquee>\n</div>\n",
			"type": "registry:component",
			"target": "efferd/logo-cloud/three/logo-cloud-three.svelte"
		}
	]
}