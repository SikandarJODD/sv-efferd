ar.MenuButton isActive={item.path === pathname}>\n\t\t\t\t\t\t\t\t{#snippet child({ props })}<a href={item.path} {...props}>{#if item.icon}<item.icon />{/if}<span>{item.title}</span></a>{/snippet}\n\t\t\t\t\t\t\t</Sidebar.MenuButton>\n\t\t\t\t\t\t{/if}\n\t\t\t\t\t</Sidebar.MenuItem>\n\t\t\t\t{/snippet}\n\t\t\t</Collapsible.Root>\n\t\t{/each}\n\t</Sidebar.Menu>\n</Sidebar.Group>\n",
