		{
			"content": "<script lang=\"ts\">\n\timport ArrowDownIcon from \"@lucide/svelte/icons/arrow-down\";\n\timport ArrowUpIcon from \"@lucide/svelte/icons/arrow-up\";\n\timport ChevronDownIcon from \"@lucide/svelte/icons/chevron-down\";\n\timport ChevronUpIcon from \"@lucide/svelte/icons/chevron-up\";\n\timport MinusIcon from \"@lucide/svelte/icons/minus\";\n\timport TrendingDownIcon from \"@lucide/svelte/icons/trending-down\";\n\timport TrendingUpIcon from \"@lucide/svelte/icons/trending-up\";\n\timport { Badge } from \"#lib/components/ui/badge/index.js\";\n\timport { cn } from \"#lib/utils.js\";\n\n\ttype DeltaIconVariant = \"default\" | \"trend\" | \"arrow\";\n\ttype DeltaVariant = \"default\" | \"badge\";\n\n\tlet {\n\t\tvalue,\n\t\tvariant = \"default\",\n\t\ticon = \"default\",\n\t\tprecision = 1,\n\t\tsuffix = \"%\"\n\t}: {\n\t\tvalue: number;\n\t\tvariant?: DeltaVariant;\n\t\ticon?: DeltaIconVariant;\n\t\tprecision?: number;\n\t\tsuffix?: string;\n\t} = $props();\n\n\tconst Icon = $derived.by(() => {\n\t\tif (value === 0) return MinusIcon;\n\t\tif (icon === \"trend\") return value > 0 ? TrendingUpIcon : TrendingDownIcon;\n\t\tif (icon === \"arrow\") return value > 0 ? ArrowUpIcon : ArrowDownIcon;\n\t\treturn value > 0 ? ChevronUpIcon : ChevronDownIcon;\n\t});\n\n\tconst tone = $derived(\n\t\tvalue > 0 ? \"text-emerald-600\" : value < 0 ? \"text-rose-600\" : \"text-muted-foreground\"\n\t);\n</script>\n\n{#if variant === \"badge\"}\n\t<Badge\n\t\tvariant=\"secondary\"\n\t\tclass={cn(\n\t\t\t\"gap-1 border-none tabular-nums\",\n\t\t\tvalue > 0\n\t\t\t\t? \"bg-emerald-500/10 text-emerald-600\"\n\t\t\t\t: value < 0\n\t\t\t\t\t? \"bg-rose-500/10 text-rose-600\"\n\t\t\t\t\t: \"text-muted-foreground\"\n\t\t)}\n\t>\n\t\t<Icon data-icon=\"inline-start\" />\n\t\t{Math.abs(value).toFixed(precision)}{suffix}\n\t</Badge>\n{:else}\n\t<span class={cn(\"inline-flex items-center gap-1 text-xs tabular-nums\", tone)}>\n\t\t<Icon class=\"size-3 shrink-0\" />\n\t\t{Math.abs(value).toFixed(precision)}{suffix}\n\t</span>\n{/if}\n",
			"type": "registry:component",
			"target": "efferd/dashboard/dashboard-one/delta.svelte"
		},
		{
			"content": "const DASHBOARD_LOCALE = \"en-US\";\n\nexport function formatDate(date: Date, style: \"day-month\" | \"full\" = \"day-month\") {\n\treturn date.toLocaleDateString(DASHBOARD_LOCALE, {\n\t\tday: \"numeric\",\n\t\tmonth: style === \"full\" ? \"long\" : \"short\",\n\t\t...(style === \"full\" ? { weekday: \"short\" as const } : {})\n\t});\n}\n",
			"type": "registry:file",
			"target": "efferd/dashboard/dashboard-one/formatter.ts"
		}
