			"content": "<script lang=\"ts\">\n\timport { Button } from \"#lib/components/ui/button/index.js\";\n\timport { XIcon } from \"@lucide/svelte\";\n\n\tconst latestChange = {\n\t\ttitle: \"Real-time funnels\",\n\t\tdescription: \"Build and analyze conversion funnels with live event streaming in real-time.\",\n\t\turl: \"#\"\n\t} as const;\n\tlet isOpen = $state(true);\n</script>\n\n{#if isOpen}\n\t<div class=\"group/latest-change z-20 size-full justify-center rounded-lg border bg-background\">\n\t\t<div class=\"relative flex size-full flex-col gap-1.5 overflow-hidden px-3 pt-4 pb-1\">\n\t\t\t<p class=\"font-heading text-xs font-medium\">{latestChange.title}</p>\n\t\t\t<span class=\"text-[10px] text-muted-foreground\">{latestChange.description}</span>\n\t\t\t<Button class=\"w-max px-0 text-xs font-light\" href={latestChange.url} size=\"sm\" variant=\"link\">Read more</Button>\n\t\t\t<Button aria-label=\"Dismiss update\" class=\"absolute top-2 right-2 z-10 size-6 rounded-full opacity-0 transition-opacity group-hover/latest-change:opacity-100 focus-visible:opacity-100\" onclick={() => (isOpen = false)} size=\"icon-sm\" variant=\"secondary\"><XIcon class=\"size-3.5 text-muted-foreground\" /></Button>\n\t\t</div>\n\t</div>\n{/if}\n",
